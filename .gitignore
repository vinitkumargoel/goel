# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
# Finder's custom-folder-icon file, which is literally "Icon" + a carriage
# return. Matched via a control-character class rather than the more common
# `Icon?`: `?` matches any single character, so `Icon?` also swallowed the
# browser extension's `icons/` directory and quietly kept it out of the repo.
Icon[[:cntrl:]]
._*
.Spotlight-V100
.Trashes

# ---- Swift Package Manager ----
.build/
.swiftpm/
Packages/
*.xcodeproj/
# Package.resolved IS committed for an app (locks dependency versions) — do not ignore it.

# ---- Xcode ----
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- SwiftPM / build artifacts ----
*.o
*.swiftmodule
.netrc

# ---- Editor / tooling ----
.vscode/
.idea/
*.swp
*~

# ---- Project scratch ----
# Quick Look / icon rasterization scratch is generated under /tmp, not tracked.
# Generated app icons in Assets/ (*.icns, *-1024.png) are derived from the SVG
# masters; keep the SVGs tracked. Uncomment the next lines to stop tracking the
# generated raster output:
# Assets/*.icns
# Assets/*-1024.png

# ---- Distribution / local build output ----
# The assembled .app links Homebrew's libtorrent/openssl at absolute paths, so
# it's a local build artifact — rebuild it with `swift build -c release`.
/dist/

# ---- Local scratch binaries (one-off Sendable/audit probes) ----
/check_sendable
/check_sendable_strict

# ---- UI scratch (contains a stale built .app + screenshots) ----
/scratchpad-app/

# ---- Playwright CLI local session state (browser testing scratch) ----
/.playwright-cli/

# ---- Cloudflare Wrangler local cache (website/ Worker dev + deploy scratch) ----
.wrangler/

# Linux-vendored SQLite (build with Scripts/linux/build-sqlite.sh)
Vendor/linux/sqlite/*.so
Vendor/linux/sqlite/sqlite3.c
Vendor/linux/sqlite/sqlite3.h

# macOS-vendored native libraries (build with Scripts/macos/build-deps.sh).
# Several hundred MB of source trees and build output, reproducible from the
# pinned versions and digests in that script. Never commit one.
Vendor/macos/

# ---- Vendored ffmpeg (maintainer-staged, ~70 MB Mach-O) ----
# Scripts/fetch_ffmpeg.sh reads an optional local binary from
# Vendor/ffmpeg/<arch>/ffmpeg. Never commit one.
Vendor/ffmpeg/

# ---- Keynote film source (video/) ----
# The Remotion project that produces Assets/videos/goel-keynote-demo.mp4.
# Source is committed; everything below is regenerated, not authored.
#   npm install && npm run capture && npm run render
# NOTE: gitignore has no trailing comments — a `#` mid-line is part of the
# pattern. Each note therefore gets its own line.
/video/node_modules/
# render + still-frame QA output
/video/out/
# 2x UI captures, rebuilt by `npm run capture`
/video/public/textures/
# licensed BGM/SFX, fetched by `npm run audio` — see video/AUDIO.md
/video/public/audio/
/video/.remotion/
# src/layout.json is generated by the same capture run as the textures, but it
# IS committed: it is the element-coordinate contract every shot is written
# against, it diffs as text, and `npm run typecheck` fails without it.

# ---- Web portal source (portal/) ----
# The React app served by the macOS app and the Linux daemon at `/`.
# Source is committed; the two entries below are build output.
#   cd portal && npm install && npm run build
/portal/node_modules/
# Vite output, consumed by scripts/codegen.mjs and then discarded. The compiled
# bundle IS committed, but as Sources/GoelCore/Remote/Generated/PortalBundle.swift
# — that file is what `swift build` needs, and it must stay tracked so the app
# builds on a machine with no Node installed.
/portal/dist/

# ---- Claude Code ----
# Agent scratch worktrees, created per-session.
.claude/worktrees/
