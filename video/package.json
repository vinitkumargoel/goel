{
  "name": "goel-keynote-film",
  "version": "1.0.0",
  "private": true,
  "description": "Source project for Assets/videos/goel-keynote-demo.mp4",
  "type": "module",
  "scripts": {
    "audio": "./scripts/fetch-audio.sh",
    "capture": "node capture/capture.mjs",
    "prerender": "npm run audio && npm run capture",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts GoelKeynote out/promo.mp4",
    "still": "remotion still src/index.ts GoelKeynote",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.398",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.398"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "puppeteer": "23.11.1",
    "typescript": "5.7.2"
  }
}
