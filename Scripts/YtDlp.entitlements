<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the bundled yt-dlp helper ONLY
  (Contents/Resources/yt-dlp). build_app.sh applies this file to that one
  binary; the app and its main executable use the minimal Goel.entitlements.

  * disable-library-validation — yt-dlp is PyInstaller-frozen and dlopen's its
    own unsigned Python extension modules (.so) from a temporary directory at
    run time. Library validation would reject every one of them.
  * allow-jit / allow-unsigned-executable-memory — the embedded Python runtime
    (and some of its extension modules) can require executable memory that is
    not code-signed.

  These are accepted by Apple's notary service. They are scoped to a separate
  process that Goel° launches with a fixed argument vector, so they do not
  weaken the main app's protection against dylib injection or W^X violations.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
