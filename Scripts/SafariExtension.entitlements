<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for GoelSafariExtension.appex ONLY.

  pkd refuses to register an app extension that is not App-Sandboxed: it adds
  the plug-in and immediately uninstalls it, with no error logged, so Goel°
  Capture never appears in Safari's extension list. The handler needs nothing
  beyond the sandbox itself — NSWorkspace.open of goeldownloader:// is brokered
  by LaunchServices and is allowed from inside it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
