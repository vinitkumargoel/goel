{
  "manifest_version": 3,
  "name": "Goel° Capture",
  "version": "1.2",
  "description": "Send downloads to Goel° on your Mac. Toolbar button toggles capture; right-click any link or media for one-off sends, including downloads that need your login.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "storage"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Goel° — click to toggle download capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "goel@goeldownloader.app",
      "strict_min_version": "128.0"
    }
  }
}
